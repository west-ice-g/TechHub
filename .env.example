# TechHub 环境变量示例
# 复制为 .env 后填写本地/服务器实际值。.env 已被 .gitignore 忽略，禁止提交真实密码。

# ---------- 应用 ----------
APP_NAME=TechHub
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_TIMEZONE=Asia/Shanghai
APP_BASE_PATH=
SESSION_NAME=TECHHUBSESSID
SESSION_LIFETIME=7200
APP_PORT=8090

# ---------- 应用数据库连接 ----------
# Docker Compose 内使用 db；直接在宿主机运行 PHP 时改为 127.0.0.1。
DB_HOST=db
DB_PORT=3306
DB_DATABASE=techhub
DB_USERNAME=techhub_app
DB_PASSWORD=change-me-app
DB_CHARSET=utf8mb4

# ---------- Docker MySQL 初始化 ----------
# 默认安装 SQL 使用 techhub 库名；如需改库名，必须同步修改 data/install.sql 和迁移文件。
MYSQL_DATABASE=techhub
MYSQL_USER=techhub_app
MYSQL_PASSWORD=change-me-app
MYSQL_ROOT_PASSWORD=change-me-root

# DB_PASSWORD 与 MYSQL_PASSWORD 必须一致。deploy.sh 会检查。
# 应用账号默认只有 SELECT/INSERT/UPDATE/DELETE，不具备建表权限。

# ---------- 首次部署管理员 ----------
# 仅用于 deploy.sh 首次初始化管理员密码，不写入数据库明文、不提交 Git。
# 首次登录后应改为自己的强密码；RESET_ADMIN_PASSWORD=1 可强制重置。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-admin
INITIAL_EDITOR_USERNAME=editor
INITIAL_EDITOR_PASSWORD=change-me-editor
RESET_ADMIN_PASSWORD=0
